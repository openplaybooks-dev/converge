{
  "taskId": "03-api-routes/002-tasks-routes",
  "checks": [
    {
      "id": "tasks-routes-exist",
      "description": "All three route handlers exist",
      "cmd": "test -f 'packages/converge-studio/src/app/api/playbooks/[name]/tasks/route.ts' && test -f 'packages/converge-studio/src/app/api/playbooks/[name]/tasks/[...path]/route.ts' && test -f 'packages/converge-studio/src/app/api/playbooks/[name]/tasks/[...path]/reset/route.ts'"
    },
    {
      "id": "nodejs-runtime",
      "description": "All three routes export runtime = 'nodejs'",
      "cmd": "find 'packages/converge-studio/src/app/api/playbooks/[name]/tasks' -name 'route.ts' | xargs grep -l \"runtime = 'nodejs'\" | wc -l | xargs test 3 -eq"
    },
    {
      "id": "typecheck",
      "description": "Routes typecheck",
      "cmd": "pnpm --filter @converge/studio typecheck 2>&1 | grep -c 'error TS' | xargs test 0 -eq"
    }
  ]
}