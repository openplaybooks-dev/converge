{
  "taskId": "04-build-sections/006-02-design",
  "checks": [
    {
      "id": "design-md-exists",
      "description": "apps/landing/.content/sections/quickstart/DESIGN.md exists",
      "cmd": "test -f apps/landing/.content/sections/quickstart/DESIGN.md"
    },
    {
      "id": "design-has-content",
      "description": "DESIGN.md has >=30 lines",
      "cmd": "test -f apps/landing/.content/sections/quickstart/DESIGN.md && test $(wc -l < apps/landing/.content/sections/quickstart/DESIGN.md) -ge 30"
    },
    {
      "id": "design-lists-imports",
      "description": "DESIGN.md lists which UI/layout primitives to import",
      "cmd": "test -f apps/landing/.content/sections/quickstart/DESIGN.md && grep -qE 'import|components/ui|components/layout' apps/landing/.content/sections/quickstart/DESIGN.md"
    }
  ]
}