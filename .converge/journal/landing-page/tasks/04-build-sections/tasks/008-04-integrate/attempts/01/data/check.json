{
  "taskId": "04-build-sections/008-04-integrate",
  "checks": [
    {
      "id": "index-astro-exists",
      "description": "index.astro exists",
      "cmd": "test -f apps/landing/src/pages/index.astro"
    },
    {
      "id": "component-imported",
      "description": "CtaBanner is imported in index.astro",
      "cmd": "test -f apps/landing/src/pages/index.astro && grep -qE \"import\\s+CtaBanner\\s+from\" apps/landing/src/pages/index.astro"
    },
    {
      "id": "component-rendered",
      "description": "<CtaBanner> is rendered in index.astro",
      "cmd": "test -f apps/landing/src/pages/index.astro && grep -qE '<CtaBanner\\b' apps/landing/src/pages/index.astro"
    },
    {
      "id": "build-clean",
      "description": "astro check still passes after integration",
      "cmd": "test -f apps/landing/package.json && pnpm --filter @converge/landing astro check"
    }
  ]
}