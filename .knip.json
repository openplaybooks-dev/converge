{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["vitest.config.ts", "tests/**/*.test.ts"],
      "project": ["tests/**/*.ts"]
    },
    "packages/cli": {
      "entry": ["src/index.ts", "src/main.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/index.tsx"],
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    }
  },
  "ignore": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "examples/**",
    "dist/**",
    "node_modules/**",
    "packages/core/src/task/lifecycle/**",
    "packages/core/src/planning/progressive-decomposition/**",
    "packages/core/src/navigator/repair/attempt-tracker.ts",
    "packages/core/src/navigator/repair/health-checks.ts",
    "packages/core/src/navigator/repair/repair-memory.ts",
    "packages/acpfn/src/**",
    "packages/claudefn/src/**",
    "packages/codexfn/src/**",
    "packages/deepcodefn/src/**",
    "packages/geminifn/src/**",
    "packages/kimifn/src/**",
    "packages/openfn/src/**",
    "packages/qwenfn/src/**"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "tsx",
    "tsup",
    "vitest",
    "prettier",
    "sass"
  ],
  "entry": [
    "packages/*/src/index.{ts,tsx}!"
  ],
  "project": [
    "packages/*/src/**/*.{ts,tsx}!"
  ]
}
