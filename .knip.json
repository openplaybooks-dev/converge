{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["vitest.config.ts", "tests/**/*.test.ts"],
      "project": ["tests/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/index.tsx"],
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    }
  },
  "ignore": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "examples/**",
    "dist/**",
    "node_modules/**"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "tsx",
    "tsup",
    "vitest",
    "prettier",
    "sass"
  ],
  "entry": [
    "packages/*/src/index.{ts,tsx}!"
  ],
  "project": [
    "packages/*/src/**/*.{ts,tsx}!"
  ]
}
