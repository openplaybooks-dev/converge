{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "bg":         "#0F1117",
    "bgElev":     "#1E293B",
    "indigo":     "#6366F1",
    "cyan":       "#22D3EE",
    "violet":     "#A78BFA",
    "text":       "#F8FAFC",
    "textMuted":  "#94A3B8",
    "textDim":    "#64748B",
    "accent":     "#EF4444",
    "border":     "#1E293B"
  },
  "spacing": {
