---
import { Code } from 'astro:components';

interface Props {
  code: string;
  language?: 'bash' | 'typescript' | 'python' | 'yaml' | 'markdown';
  filename?: string;
  copyable?: boolean;
}

const { code, language = 'typescript', filename, copyable = true } = Astro.props;
---

<div class="rounded-lg border border-border overflow-hidden">
  {filename && (
    <div class="px-4 py-2 bg-bgElev border-b border-border text-textMuted text-sm">
      {filename}
    </div>
  )}
  <div class="relative code-block">
    <Code code={code} lang={language} theme="github-dark" />
    {copyable && (
      <button
        class="absolute top-2 right-2 px-2 py-1 text-xs bg-bgElev border border-border rounded text-textMuted hover:text-text transition-colors"
        data-copy={code}
      >
        Copy
      </button>
    )}
  </div>
</div>

<style>
  .code-block :global(pre.astro-code) {
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.875rem;
    margin: 0;
  }
</style>

<script>
  document.querySelectorAll('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const text = btn.getAttribute('data-copy') ?? '';
      navigator.clipboard.writeText(text);
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
    });
  });
</script>
