---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';

interface Props {}
const {} = Astro.props;
---

<Section id="social-proof" padY="sm" bg="muted">
  <Container>
    <p class="text-sm text-center text-text-muted mb-6">Used by early builders</p>
    <div class="flex flex-wrap gap-8 justify-center items-center">
      <a href="https://github.com/myanlabs/converge" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-text hover:text-indigo transition-colors">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
        <span class="font-medium">Star on GitHub</span>
      </a>
      <span class="text-text-muted">·</span>
      <a href="https://www.npmjs.com/package/converge" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-text hover:text-indigo transition-colors">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12s5.37 12 12 12 12-5.37 12-12S18.63 0 12 0zm0 4.8c5.19 0 9.2 4.01 9.2 9.2s-4.01 9.2-9.2 9.2c-5.19 0-9.2-4.01-9.2-9.2S6.81 4.8 12 4.8z"/></svg>
        <span class="font-medium">npm downloads</span>
      </a>
    </div>
  </Container>
</Section>
