---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Button from '../ui/Button.astro';

interface Props {}
const {} = Astro.props;
---

<Section id="hero" padY="lg" bg="default">
  <Container>
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Copy -->
      <div class="text-center lg:text-left order-2 lg:order-1">
        <p class="text-sm font-medium tracking-widest text-indigo uppercase mb-4">
          Open-source · TypeScript-native
        </p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-text mb-4 leading-tight">
          Define done.<br class="hidden sm:inline"/>
          <span class="bg-gradient-to-r from-indigo via-violet to-cyan bg-clip-text text-transparent">
            Converge gets there.
          </span>
        </h1>
        <p class="text-lg text-text-muted mb-8 max-w-xl mx-auto lg:mx-0">
          Declare the files and shell-verifiable checks that define <strong class="text-text">done</strong>.
          The framework measures the gap, plans the work to close it, and self-corrects until every check
          passes — autonomously, for hours, resumable from disk.
        </p>
        <div class="flex flex-wrap gap-4 justify-center lg:justify-start items-center">
          <Button href="/examples/readme" variant="primary" size="lg">Browse examples</Button>
          <Button href="#quickstart" variant="ghost" size="lg">Quickstart</Button>
        </div>
      </div>

      <!-- Hero artifact: a real `converge status` task tree in a terminal frame -->
      <div class="order-1 lg:order-2 flex justify-center">
        <div class="hero-art relative w-full max-w-[560px]">
          <!-- Soft halo behind the terminal -->
          <div class="hero-halo" aria-hidden="true"></div>

          <div
            class="terminal relative rounded-xl border border-border bg-bg-elev/90 shadow-2xl backdrop-blur"
            role="img"
            aria-label="The converge status command, showing a task tree where most tasks are complete, one is running, and the next is queued."
          >
            <!-- Title bar -->
            <div class="flex items-center gap-2 px-4 py-3 border-b border-border/80">
              <span class="block w-3 h-3 rounded-full bg-[#FF5F57]"></span>
              <span class="block w-3 h-3 rounded-full bg-[#FEBC2E]"></span>
              <span class="block w-3 h-3 rounded-full bg-[#28C840]"></span>
              <span class="ml-3 text-xs text-text-dim font-mono tracking-wide">
                converge status
              </span>
            </div>

            <!-- Body -->
            <pre class="terminal-body px-5 py-5 text-[12.5px] leading-[1.65] font-mono text-text overflow-x-auto"><span class="text-text-dim">$</span> <span class="text-cyan">converge</span> status

<span class="text-text-muted">📁</span> .converge/playbooks/landing-page/tasks/
    ├── <span class="text-emerald">✓</span>  1-5.  01-prepare-spec       <span class="text-text-dim">[4/4 done]</span>
    ├── <span class="text-emerald">✓</span>  6-11. 02-bootstrap-astro    <span class="text-text-dim">[5/5 done]</span>
    ├── <span class="text-violet">◑</span>  18.   04-build-sections     <span class="text-text-dim">(seeded) [40/48]</span>
    └── <span class="text-text-muted">○</span>  46-55. 10-verify  <span class="text-indigo">▶</span>
            ├── <span class="text-emerald">✓</span> 47. 001-build-clean
            ├── <span class="hero-running text-cyan">⟳</span> 48. 002-dev-smoke   <span class="text-text-dim">← running</span>
            └── <span class="text-text-muted">○</span> ...

<span class="text-text-muted">📊</span> Tasks: <span class="text-text">60</span>  <span class="text-emerald">✓ 51</span>  <span class="text-cyan">⟳ 1</span>  <span class="text-accent">✗ 0</span>  <span class="text-text-muted">○ 8</span>
<span class="text-indigo">▶</span>  Next subtask: 10-verify / 002-dev-smoke<span class="hero-cursor" aria-hidden="true">▍</span></pre>
          </div>
        </div>
      </div>
    </div>
  </Container>
</Section>

<style>
  /* Soft indigo halo behind the terminal — gives the artifact some depth
     without competing with the terminal contents. */
  .hero-art .hero-halo {
    position: absolute;
    inset: -10% -8% -12% -8%;
    z-index: 0;
    background:
      radial-gradient(60% 60% at 30% 20%, rgba(99, 102, 241, 0.28), transparent 70%),
      radial-gradient(55% 55% at 80% 90%, rgba(34, 211, 238, 0.18), transparent 70%);
    filter: blur(24px);
    pointer-events: none;
  }
  .hero-art .terminal {
    z-index: 1;
  }

  /* Use the existing semantic palette where available, plus a single
     emerald (for ✓) that the project's tokens.css does not currently expose. */
  .hero-art .text-emerald { color: #34D399; }

  /* The running task (⟳) spins; the prompt cursor blinks. Both are subtle
     so the artifact reads as a still terminal capture with a heartbeat. */
  .hero-art .hero-running {
    display: inline-block;
    animation: hero-spin 1.4s linear infinite;
  }
  @keyframes hero-spin {
    to { transform: rotate(360deg); }
  }

  .hero-art .hero-cursor {
    display: inline-block;
    margin-left: 0.25rem;
    color: var(--color-indigo);
    animation: hero-blink 1.05s steps(1) infinite;
  }
  @keyframes hero-blink {
    0%, 50%   { opacity: 1; }
    50.01%, 100% { opacity: 0; }
  }

  /* Respect user motion preference. */
  @media (prefers-reduced-motion: reduce) {
    .hero-art .hero-running,
    .hero-art .hero-cursor {
      animation: none;
    }
  }
</style>
