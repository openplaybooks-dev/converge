---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';

interface FaqItem {
  id: string;
  question: string;
  answer: string;
}

const items: FaqItem[] = [
  {
    id: 'production-ready',
    question: 'Can it actually build production code, or is it a demo?',
    answer: 'Production. The fullstack-app, flutter-app, and game-aiwolf playbooks each generate runnable codebases with passing tests. The autonomous-pentest playbook spawns ~250 tasks per run and ships findings only with reproducible PoCs. Browse the examples gallery — every playbook there is real and runnable.',
  },
  {
    id: 'use-case-not-in-examples',
    question: 'What if my use case isn\'t in the examples?',
    answer: 'Start with the closest match and edit the spec. The examples are designed to be cloned. If nothing fits, the From your problem to a playbook guide walks through articulating a goal and shaping it into a TASK.md from scratch.',
  },
  {
    id: 'run-time',
    question: 'How long does a run take? How much does it cost?',
    answer: 'It depends on the playbook. Hello World finishes in seconds. Deep research takes minutes to hours depending on layer count. Cinematic video runs ~hours per short film. Autonomous pentest is roughly $5–15 per run on Juice Shop. Each example page lists realistic ranges.',
  },
  {
    id: 'providers',
    question: 'Which model providers are supported?',
    answer: 'Claude, Gemini, Kimi, and Qwen via the agentfn abstraction. Switching providers is a config change, not a rewrite — playbooks are model-independent.',
  },
  {
    id: 'crash-recovery',
    question: 'What happens if a long run crashes mid-way?',
    answer: 'Kill the process, restart, and Converge picks up exactly where it left off. Every task checkpoint is on disk in the journal. A 4-hour pipeline that crashes after hour 3 resumes from hour 3, not from zero.',
  },
  {
    id: 'vs-other-frameworks',
    question: 'How is this different from LangGraph, AutoGen, or CrewAI?',
    answer: 'Those frameworks ask you to wire a graph or assemble agents — you define how. Converge asks you to describe done — outputs and shell checks — and the runner figures out the path. See the comparisons page for a side-by-side breakdown.',
  },
];
---

<Section id="faq" padY="lg" bg="muted">
  <Container>
    <h2 class="text-3xl font-bold text-text text-center mb-12">Frequently asked questions</h2>
    <div class="max-w-2xl mx-auto space-y-4">
      {items.map((item, i) => (
        <>
          {i > 0 ? "\n" : null}
          <details id={item.id} class="group bg-default border border-border rounded-lg">
            <summary class="flex items-center justify-between cursor-pointer list-none px-6 py-4 font-medium text-text hover:text-indigo transition-colors">
              {item.question}
              <svg class="w-5 h-5 text-text-muted group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-4 text-text-muted leading-relaxed">
              {item.answer}
            </div>
          </details>
        </>
      ))}
    </div>
  </Container>
</Section>
