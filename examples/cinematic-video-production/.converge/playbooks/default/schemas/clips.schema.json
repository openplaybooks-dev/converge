{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "clips.json",
  "type": "object",
  "required": ["version", "fps", "clips"],
  "properties": {
    "version": { "const": 1 },
    "fps": { "type": "integer", "enum": [24, 25, 30] },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["clip_id", "shot_id", "scene_id", "order", "path", "duration_s", "audio"],
        "properties": {
          "clip_id": { "type": "string" },
          "shot_id": { "type": "string" },
          "scene_id": { "type": "string" },
          "order": { "type": "integer" },
          "path": { "type": "string" },
          "duration_s": { "type": "number" },
          "in_tc": { "type": "string", "description": "HH:MM:SS:FF timeline in-point" },
          "out_tc": { "type": "string" },
          "transition_in": { "type": "string" },
          "transition_out": { "type": "string" },
          "audio": {
            "type": "object",
            "properties": {
              "dialogue": { "type": ["string", "null"] },
              "sfx": { "type": ["string", "null"] },
              "music": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
