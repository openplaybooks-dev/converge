# Copy this file to `.env` and fill in your real keys.
# `.env` is gitignored — never commit it.
#
# Loaded automatically by scripts/_load_env.js at the top of every script
# that calls a real backend. Shell-exported env vars take precedence
# (so you can override these per-run with `MESHY_API_KEY=other... converge run`).

# ── nanobanana / Gemini 2.5 Flash Image ──
# Required when image-generate/backends/ACTIVE = "gemini"
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Meshy AI ──
# Required when meshy-generate/backends/ACTIVE = "meshy" (Pro tier or higher).
# Get one at https://www.meshy.ai/settings/api
MESHY_API_KEY=

# ── Optional: debug ──
# Uncomment to log which env vars _load_env.js loaded from .env
# CONVERGE_ENV_DEBUG=1
