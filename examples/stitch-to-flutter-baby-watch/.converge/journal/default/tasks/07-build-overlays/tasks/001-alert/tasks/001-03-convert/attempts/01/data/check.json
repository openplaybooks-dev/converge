{
  "taskId": "07-build-overlays/001-alert/001-03-convert",
  "checks": [
    {
      "id": "widget-exists",
      "description": "Overlay widget file exists",
      "cmd": "test -f lib/widgets/overlays/alert/alert.dart"
    },
    {
      "id": "dart-valid",
      "description": "Dart analysis passes",
      "cmd": "dart analyze lib/widgets/overlays/alert/alert.dart"
    },
    {
      "id": "uses-theme",
      "description": "Uses Theme.of(context) for styling",
      "cmd": "grep -q 'Theme.of(context)' lib/widgets/overlays/alert/alert.dart"
    },
    {
      "id": "no-hardcoded-colors",
      "description": "No hardcoded colors — uses colorScheme",
      "cmd": "! grep -qE 'Color\\(0x|Colors\\.' lib/widgets/overlays/alert/alert.dart"
    },
    {
      "id": "no-router-registration",
      "description": "Overlay does NOT register a GoRoute",
      "cmd": "! grep -q 'GoRoute' lib/widgets/overlays/alert/alert.dart"
    }
  ]
}