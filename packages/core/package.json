    "hierarchical",
    "multi-agent",
    "autonomous-agents",
    "task-planning",
    "task-automation",
    "task-execution",
    "workflow",
    "autonomous",
    "agent-driven-development",
    "codegen",
    "ai-coding",
    "llm",
    "llm-orchestration"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
