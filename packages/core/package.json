{
  "name": "@openplaybooks/converge-core",
  "version": "0.4.5",
  "private": false,
  "type": "module",
  "description": "A build system for AI agents — Plan. Execute. Verify. Fix. Ship.",
  "license": "MIT",
  "author": "Converge Framework Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/openplaybooks-dev/converge.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
