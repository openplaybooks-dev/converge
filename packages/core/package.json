{
  "name": "@converge/core",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "A build system for AI agents — Plan. Execute. Verify. Fix. Ship.",
  "license": "MIT",
  "author": "Converge Framework Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/myanlabs/converge.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "agent",
    "ai-agent",
    "orchestrator",
    "orchestration",
    "automation",
    "build-system",
    "cli",
    "framework",
    "typescript",
    "reactive",
    "agentic",
    "code-generation",
    "testing",
    "verification",
    "quality-gates",
    "resumable",
    "crash-safe",
    "hierarchical",
    "multi-agent",
    "autonomous-agents",
    "task-planning",
    "task-automation",
    "task-execution",
    "workflow",
    "autonomous",
    "agent-driven-development",
    "codegen",
    "ai-coding",
    "llm",
    "llm-orchestration"
  ],
  "bin": {
    "converge": "../cli/dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./src/index.ts"
    },
    "./run": {
      "import": "./dist/run.js",
      "types": "./src/run.ts"
    },
    "./plan": {
      "import": "./dist/plan.js",
      "types": "./src/plan.ts"
    },
    "./playbook": {
      "import": "./dist/playbook.js",
      "types": "./src/playbook.ts"
    },
    "./planner": {
      "import": "./dist/planner.js",
      "types": "./src/playbooks/planner/index.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./src/client/index.ts"
    },
    "./studio-api": {
      "import": "./dist/studio-api.js",
      "types": "./src/studio-api.ts"
    },
    "./*": {
      "import": "./src/*"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build && pnpm typecheck",
    "converge": "tsx src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/*.test.ts",
    "test:integration": "vitest run tests/integration/*.test.ts",
    "test:watch": "vitest watch",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "@converge/agentfn": "workspace:*",
    "@converge/claudefn": "workspace:*",
    "glob": "^11.0.0",
    "minimatch": "^10.2.5",
    "tsx": "^4.21.0",
    "uuid": "^11.0.3",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@converge/swebench": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
