  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build && pnpm typecheck",
    "converge": "tsx src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/*.test.ts",
    "test:integration": "vitest run tests/integration/*.test.ts",
    "test:watch": "vitest watch",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@openplaybooks/agentfn": "^0.2.3",
