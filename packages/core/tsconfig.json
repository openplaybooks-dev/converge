{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "paths": {
      "@converge/core": ["./src/index.ts"],
      "@converge/swebench": ["../swebench/src/index.ts"],
      "@converge/tbench": ["../tbench/src/index.ts"]
    }
  },
  "include": ["src"]
}
