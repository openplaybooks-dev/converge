{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@openplaybooks/converge-core": ["./src/index.ts"],
      "@openplaybooks/converge-agentfn": ["../agentfn/src/index.ts"],
      "@openplaybooks/converge-agentfn/skills": ["../agentfn/src/skills.ts"],
      "@openplaybooks/acpfn": ["../acpfn/src/index.ts"],
      "@openplaybooks/claudefn": ["../claudefn/src/index.ts"],
      "@openplaybooks/codexfn": ["../codexfn/src/index.ts"],
      "@openplaybooks/deepcodefn": ["../deepcodefn/src/index.ts"],
      "@openplaybooks/geminifn": ["../geminifn/src/index.ts"],
      "@openplaybooks/kimifn": ["../kimifn/src/index.ts"],
      "@openplaybooks/openfn": ["../openfn/src/index.ts"],
      "@openplaybooks/converge-swebench": ["../swebench/src/index.ts"],
      "@openplaybooks/converge-tbench": ["../tbench/src/index.ts"],
      "@openplaybooks/qwenfn": ["../qwenfn/src/index.ts"]
    }
  },
  "include": ["src"]
}
