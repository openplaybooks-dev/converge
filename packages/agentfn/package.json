{
  "name": "@converge/agentfn",
  "version": "0.1.0",
  "private": false,
  "description": "Unified agent function — switch between Claude, Kimi, Qwen, and Gemini providers in a single interface",
  "license": "MIT",
  "author": "Converge Framework Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/myanlabs/converge.git",
    "directory": "packages/agentfn"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./skills": {
      "types": "./dist/skills.d.ts",
      "import": "./dist/skills.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@converge/acpfn": "workspace:*",
    "@converge/project-root": "workspace:*",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "@converge/claudefn": "workspace:*",
    "@converge/kimifn": "workspace:*",
    "@converge/qwenfn": "workspace:*",
    "@converge/geminifn": "workspace:*",
    "@converge/openfn": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@converge/claudefn": { "optional": true },
    "@converge/kimifn": { "optional": true },
    "@converge/qwenfn": { "optional": true },
    "@converge/geminifn": { "optional": true },
    "@converge/openfn": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.1.0",
    "@types/node": "^22.0.0"
  }
}
