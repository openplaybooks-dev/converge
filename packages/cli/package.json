{
  "name": "@openplaybooks/converge",
  "version": "0.4.6",
  "private": false,
  "type": "module",
  "description": "CLI for Converge - A build system for AI agents",
  "license": "MIT",
  "author": "Converge Framework Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/openplaybooks-dev/converge.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "converge",
    "ai-agent",
    "automation",
    "orchestration"
  ],
  "bin": {
    "converge": "./dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build && rm -rf ./skills && cp -r ../../skills ./skills",
    "test": "vitest run",
    "converge": "tsx src/main.ts"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "@openplaybooks/agentfn": "^0.2.3",
    "@openplaybooks/claudefn": "^0.1.0",
    "@openplaybooks/codexfn": "^0.1.0",
    "@openplaybooks/converge-core": "^0.4.1",
    "@openplaybooks/converge-studio": "^0.4.2",
    "@openplaybooks/deepcodefn": "^0.1.0",
    "@openplaybooks/openfn": "^0.1.0",
    "glob": "^13.0.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
